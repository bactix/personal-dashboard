# Copy to .env.local. Every variable must also be declared in src/lib/env.ts.

# Weather widget (Open-Meteo is keyless; these pick the location)
WEATHER_LOCATION_NAME=Beirut
WEATHER_LATITUDE=33.8938
WEATHER_LONGITUDE=35.5018

# Supabase holds all personal data. Project Settings -> API.
# The URL and publishable key are public by design; the SECRET key must stay on the server:
# never give it a NEXT_PUBLIC_ name and never commit it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Folder with the old JSON data; only read by the one-off import (db/import-json.mjs); git-ignored
DATA_DIR=data

# Login uses Supabase Auth (email + password). Create the owner user in Supabase
# (Authentication -> Users) and turn off public sign-ups. Only this email may use the app.
AUTH_OWNER_EMAIL=mouhamadhaydar052@gmail.com

# Set to true to turn the login off while developing locally. Ignored in production.
# AUTH_DISABLED=true
